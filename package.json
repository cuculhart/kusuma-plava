{
  "name": "kusuma-plava",
  "private": true,
  "version": "1.2.0",
  "description": "A vertical-writing layout editor for Japanese documents — write horizontally, compose vertically. Linked text frames, image runaround, true millimeter printing.",
  "type": "module",
  "workspaces": [
    "kimetron/packages/*",
    "inimbal",
    "app"
  ],
  "scripts": {
    "dev": "npm run dev -w kusuma-plava-app",
    "dev:desktop": "npm --prefix desktop run dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "package:desktop": "npm --prefix desktop run package",
    "make:desktop": "npm --prefix desktop run make"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
